<!-- The editor and diagram. Loads in the local IDE and, in split mode, on the client, where JCEF runs. -->
<idea-plugin>
    <dependencies>
        <module name="intellij.platform.frontend"/>
        <module name="intellij.platform.ui.jcef"/>
    </dependencies>
    <extensions defaultExtensionNs="com.intellij">
        <fileEditorProvider implementation="dev.jpv.intellij.JenkinsfileEditorProvider"/>
    </extensions>
</idea-plugin>

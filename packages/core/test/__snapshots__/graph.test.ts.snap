// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`graph + layout + exports > handwritten/01-basic.Jenkinsfile 1`] = `
"flowchart LR
  start((Start))
  n0["Checkout"]
  n1["Build"]
  n0 --> n1
  n2["Test"]
  n1 --> n2
  n3["Package"]
  n2 --> n3
  start --> n0
  finish((End))
  n3 --> finish
"
`;

exports[`graph + layout + exports > handwritten/02-kitchen-sink.Jenkinsfile 1`] = `
"flowchart LR
  start((Start))
  n0["Build"]
  subgraph n1["Test (parallel)"]
    direction TB
    n2["Unit"]
    subgraph n3["E2E"]
      direction LR
      n4["Setup"]
      n5["Run"]
      n4 --> n5
    end
  end
  n0 --> n1
  subgraph n6["Cross-platform (matrix, 3 cells)"]
    direction TB
    n7["linux · chrome: Smoke"]
    n8["linux · firefox: Smoke"]
    n9["windows · chrome: Smoke"]
  end
  n1 --> n6
  n10["Deploy ⟨when⟩"]
  n6 --> n10
  start --> n0
  post[/"post: failure, always"/]
  n10 -.-> post
  finish((End))
  post --> finish
  classDef when stroke-dasharray: 5 4
  class n10 when
"
`;

exports[`graph + layout + exports > handwritten/03-parallel-failfast.Jenkinsfile 1`] = `
"flowchart LR
  start((Start))
  n0["Lint"]
  subgraph n1["Tests (parallel)"]
    direction TB
    n2["Linux"]
    n3["Windows"]
    n4["macOS"]
  end
  n0 --> n1
  n5["Release ⟨when⟩"]
  n1 --> n5
  start --> n0
  finish((End))
  n5 --> finish
  classDef when stroke-dasharray: 5 4
  class n5 when
"
`;

exports[`graph + layout + exports > handwritten/04-deep-nesting.Jenkinsfile 1`] = `
"flowchart LR
  start((Start))
  n0["Prepare"]
  subgraph n1["Verify (parallel)"]
    direction TB
    subgraph n2["Backend"]
      direction LR
      n3["Compile"]
      subgraph n4["Integration"]
        direction LR
        n5["Start DB"]
        n6["IT tests"]
        n5 --> n6
      end
      n3 --> n4
    end
    subgraph n7["Frontend"]
      direction LR
      n8["Install"]
      n9["Build UI"]
      n8 --> n9
    end
    n10["Docs"]
  end
  n0 --> n1
  n11["Publish"]
  n1 --> n11
  start --> n0
  finish((End))
  n11 --> finish
"
`;

exports[`graph + layout + exports > handwritten/05-when-conditions.Jenkinsfile 1`] = `
"flowchart LR
  start((Start))
  n0["PR checks ⟨when⟩"]
  n1["Docs only ⟨when⟩"]
  n0 --> n1
  n2["Nightly ⟨when⟩"]
  n1 --> n2
  n3["Deploy staging ⟨when⟩"]
  n2 --> n3
  n4["Deploy prod ⟨when⟩"]
  n3 --> n4
  start --> n0
  post[/"post: success, unstable, fixed, regression, aborted, cleanup"/]
  n4 -.-> post
  finish((End))
  post --> finish
  classDef when stroke-dasharray: 5 4
  class n0,n1,n2,n3,n4 when
"
`;


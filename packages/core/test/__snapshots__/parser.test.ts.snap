exports[`fixtures > handwritten/05-when-conditions.Jenkinsfile 1`] = `
{
  "agent": "any",
  "diagnostics": [],
  "kind": "declarative",
  "post": [
    "success",
    "unstable",
    "fixed",
    "regression",
    "aborted",
    "cleanup",
  ],
  "preamble": [],
  "stages": [
    "PR checks [steps; when=changeRequest target: 'main']",
    "  - sh 'make pr-check'",
    "Docs only [steps; when=changeset '**/*.md']",
    "  - echo 'docs changed'",
    "Nightly [steps; when=triggeredBy 'TimerTrigger']",
    "  - sh 'make nightly'",
    "Deploy staging [steps; when=(branch 'main' or branch 'release/*') and environment name: 'ENV', value: 'staging']",
    "  - sh "deploy --env staging --version \${params.VERSION}"",
    "Deploy prod [steps; when=tag pattern: 'v\\\\d+\\\\.\\\\d+\\\\.\\\\d+', comparator: 'REGEXP' and not equals expected: 'dev', actual: params.ENV; input=Deploy to production?]",
    "  - sh 'deploy --env prod'",
  ],
}
`;


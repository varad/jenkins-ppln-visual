exports[`fixtures > handwritten/02-kitchen-sink.Jenkinsfile 1`] = `
{
  "agent": "label linux",
  "diagnostics": [],
  "kind": "declarative",
  "post": [
    "failure",
    "always",
  ],
  "preamble": [],
  "stages": [
    "Build [steps]",
    "  - sh 'make build'",
    "Test [parallel]",
    "  | Unit [steps]",
    "  |   - sh 'make unit'",
    "  | E2E [stages; agent=docker node:20]",
    "  |   Setup [steps]",
    "  |     - sh 'npm ci'",
    "  |   Run [steps]",
    "  |     - sh 'npm run e2e'",
    "Cross-platform [matrix]",
    "  axes: OS=linux,windows BROWSER=chrome,firefox; cells=3",
    "  * Smoke [steps]",
    "  *   - echo "\${OS}/\${BROWSER}"",
    "Deploy [steps; when=branch 'main' and expression { params.DEPLOY }; input=Ship it?]",
    "  - sh './deploy.sh'",
  ],
}
`;


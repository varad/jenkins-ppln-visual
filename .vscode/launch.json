{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run VS Code extension",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/packages/vscode", "${workspaceFolder}/fixtures/handwritten"],
      "outFiles": ["${workspaceFolder}/packages/vscode/dist/**/*.js"],
      "preLaunchTask": "Build VS Code extension"
    }
  ]
}
